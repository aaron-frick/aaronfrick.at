# Kontaktformular (Versand über Resend, https://resend.com)
# API-Key aus dem Resend-Dashboard. Ohne Key zeigt das Formular einen Hinweis statt zu senden.
RESEND_API_KEY=

# Empfänger der Anfragen
CONTACT_TO_EMAIL=

# Absender, muss eine in Resend verifizierte Domain nutzen, z. B. "Frick. <kontakt@aaronfrick.at>"
CONTACT_FROM_EMAIL=
